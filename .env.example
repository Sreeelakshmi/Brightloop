# Brightloop Environment Variables
# Copy this file to .env.local and fill in real values.

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Telemetry Demo Mode ───────────────────────────────────────────────────────
# Set BOTH to "true" for offline development with realistic mock data.
# Set BOTH to "false" when connecting to a real Supabase database.
NEXT_PUBLIC_USE_MOCK_DATA=true
USE_MOCK_DATA=true
